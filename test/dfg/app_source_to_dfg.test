# Runs the representative manifest tier through the source-to-DFG pipeline.
# The final marker keeps command failures visible through the FileCheck pipe.
#
# RUN: env LOOM_CC=%loom-cc LOOM_CXX=%loom-c++ LOOM_RAISE=%loom-raise LOOM_LOWER=%loom-lower LOOM_RAISE_OPT=%loom-raise-opt %python %S/../app/ir_runner.py --stage dfg --build-root %t | FileCheck %s
#
# CHECK-DAG: PASS  vecadd  dfg
# CHECK-DAG: PASS  matmul  dfg  expected-diagnostic
# CHECK: [app-ir-runner] PASS
