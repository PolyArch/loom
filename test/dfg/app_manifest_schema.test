# RUN: rm -rf %t.app
# RUN: cp -a %S/../app %t.app
# RUN: %python %S/../app/app_manifest.py validate --manifest %t.app/manifest.json
# RUN: %python -c 'import json, pathlib; path = pathlib.Path(r"%t.app/manifest.json"); data = json.loads(path.read_text()); data["schema_version"] = 1; path.write_text(json.dumps(data) + "\n")'
# RUN: not %python %S/../app/app_manifest.py validate --manifest %t.app/manifest.json 2>&1 | FileCheck %s --check-prefix=NUMERIC --match-full-lines
# RUN: %python -c 'import json, pathlib; path = pathlib.Path(r"%t.app/manifest.json"); data = json.loads(path.read_text()); data["schema_version"] = "1"; path.write_text(json.dumps(data) + "\n")'
# RUN: not %python %S/../app/app_manifest.py validate --manifest %t.app/manifest.json 2>&1 | FileCheck %s --check-prefix=STRING --match-full-lines

# NUMERIC: schema_version must be "1.1"
# STRING: schema_version must be "1.1"
