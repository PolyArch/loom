# REQUIRES: yosys
# RUN: rm -rf %t && mkdir -p %t/a %t/b %t/c %t/d %t/e %t/tmp-a %t/tmp-b %t/tmp-c %t/tmp-d %t/tmp-e
# RUN: %loom-yosys-synthesis-test %t/a mapped
# RUN: %loom-yosys-synthesis-test %t/b mapped
# RUN: %loom-yosys-synthesis-test %t/c constant
# RUN: %loom-yosys-synthesis-test %t/d dollar
# RUN: %loom-yosys-synthesis-test %t/e closure
# RUN: cd %t/a && env TMPDIR=%t/tmp-a yosys -q -s synthesize.ys
# RUN: cd %t/b && env TMPDIR=%t/tmp-b yosys -q -s synthesize.ys
# RUN: cd %t/c && env TMPDIR=%t/tmp-c yosys -q -s synthesize.ys
# RUN: cd %t/d && env TMPDIR=%t/tmp-d yosys -q -s synthesize.ys
# RUN: cd %t/e && env TMPDIR=%t/tmp-e yosys -q -s synthesize.ys
# RUN: %loom-yosys-synthesis-test --verify %t/a
# RUN: %loom-yosys-synthesis-test --verify %t/c
# RUN: %loom-yosys-synthesis-test --verify %t/d
# RUN: %loom-yosys-synthesis-test --verify %t/e
# RUN: %loom-yosys-synthesis-test --compare %t/a %t/b
