            "oracle_coverage": "all_measured_samples",
            "deadline_milliseconds": 120000
          }
        }
      ],
      "selections": [
        "smoke"
      ]
    },
    {
      "identity": "vecadd-memory",
      "source": {
        "kind": "repository",
        "root": "test/app/vecadd"
      },
      "build": {
        "entry": "main_func.c",
        "language": "c",
        "sources": [
          "main_func.c"
        ],
        "compiler_options": [
          "-O1",
          "-ffp-contract=off",
          "-fno-math-errno"
        ],
        "link_options": []
      },
      "cached_inputs": [],
      "inputs": [
        {
          "name": "smoke",
          "workload": "vecadd-memory-smoke",
          "runtime_input": "vecadd-memory-smoke-input",
          "cached_inputs": [],
          "oracle": {
