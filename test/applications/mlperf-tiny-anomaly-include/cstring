#include <stddef.h>
inline int strncmp(const char *left, const char *right, size_t count) {
  for (size_t index = 0; index < count; ++index) {
    const unsigned char lhs = static_cast<unsigned char>(left[index]);
    const unsigned char rhs = static_cast<unsigned char>(right[index]);
    if (lhs != rhs || lhs == 0 || rhs == 0)
      return static_cast<int>(lhs) - static_cast<int>(rhs);
  }
  return 0;
}
inline char *strncpy(char *destination, const char *source, size_t count) {
  size_t index = 0;
  for (; index < count && source[index] != 0; ++index)
    destination[index] = source[index];
  for (; index < count; ++index)
    destination[index] = 0;
  return destination;
}
inline size_t strnlen(const char *value, size_t maximum) {
  size_t length = 0;
  while (length < maximum && value[length] != 0)
    ++length;
  return length;
}
inline char *strcat(char *destination, const char *source) {
  size_t offset = strnlen(destination, static_cast<size_t>(-1));
  size_t index = 0;
  do {
    destination[offset + index] = source[index];
  } while (source[index++] != 0);
  return destination;
}
