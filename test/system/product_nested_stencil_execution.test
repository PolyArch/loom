# RUN:   -fno-math-errno %S/Inputs/product_nested_stencil.c -o %t.elf \
# RUN:   --loom-deploy-output=%t.deployment \
# RUN:   --loom-operator-protocol-symbol=nested_stencil \
# RUN:   > %t.build.stdout 2> %t.build.stderr
