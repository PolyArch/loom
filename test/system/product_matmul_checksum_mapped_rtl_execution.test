# The canonical mapped-RTL chain of the product Matmul checksum: the same
# Deployment retires on the DFG, CGRA, and Verilated RTL engines and every
# engine reports the independent checksum.
# REQUIRES: gem5-25.1.0.1, verilator
# RUN: rm -rf %t.deployment %t.execution
# RUN: env LOOM_VERBOSE_LEVEL=1 %loom-c++ \
# RUN:   --loom-accel-profile=%S/Inputs/product_attention_dse_grown.yaml \
# RUN:   --loom-mapping-wall-time-limit-ms=%loom-timeout-medium-ms \
# RUN:   -std=c++17 -O1 -ffp-contract=off -fno-math-errno \
# RUN:   %S/Inputs/product_matmul_checksum.cpp -o %t.elf \
# RUN:   --loom-deploy-output=%t.deployment \
# RUN:   --loom-operator-protocol-symbol=matmul_kernel \
# RUN:   > %t.build.stdout 2> %t.build.stderr
# RUN: %python -c 'import json,pathlib,shutil; executable=shutil.which("verilator"); assert executable; pathlib.Path("%t.local-tool-config.json").write_text(json.dumps({"schema":"loom.local_tool_config","version":"1.1","runtime":{"policy":"host"},"tools":{"verilator":{"binding":{"executable":str(pathlib.Path(executable).resolve())}}}}))'
# RUN: env LOOM_VERBOSE_LEVEL=1 timeout %loom-timeout-xlong loom-system-run \
# RUN:   --deployment-package=%t.deployment --output=%t.execution \
# RUN:   --gem5-readiness=%loom-gem5-readiness --expected-i32=1219 \
# RUN:   --mapped-rtl --mapped-rtl-build-jobs=8 --mapped-rtl-model-threads=8 \
# RUN:   --mapped-rtl-local-tool-config=%t.local-tool-config.json \
# RUN:   --mapped-rtl-provider-build="$(verilator --version)" \
# RUN:   > %t.run.stdout 2> %t.run.stderr
# RUN: %python -c 'import json,pathlib,shutil,subprocess; executable=str(pathlib.Path(shutil.which("verilator")).resolve()); version=subprocess.check_output(["verilator","--version"],text=True).strip(); manifests=[json.loads(path.read_text()) for path in pathlib.Path("%t.execution/bundles").glob("spatial-rtl-*/manifest.json")]; assert manifests and all(manifest["tool_binding"]["source"]=="explicit" and manifest["tool_binding"]["executable"]==executable and manifest["tool_binding"]["version"]==version for manifest in manifests)'
