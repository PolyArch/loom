# REQUIRES: circt, verilator, yosys
# RUN: rm -rf %t && mkdir -p %t
# RUN: %loom-temporal-dispatch-context-test %t
# RUN: cd %t && verilator --binary --timing --Wall --Wno-fatal --Wno-DECLFILENAME --Wno-UNUSEDSIGNAL -CFLAGS '-std=c++20' --top-module temporal_dispatch_context_invariant_testbench temporal_dispatch_context_invariant_module.sv temporal_dispatch_context_invariant_testbench.sv --Mdir obj_invariant
# RUN: timeout %loom-timeout-xlong %t/obj_invariant/Vtemporal_dispatch_context_invariant_testbench
# RUN: cd %t && yosys -q -s temporal_dispatch_context_invariant.ys
# RUN: cd %t && verilator --binary --timing --Wall --Wno-fatal --Wno-DECLFILENAME --Wno-UNUSEDSIGNAL -CFLAGS '-std=c++20' --top-module temporal_dispatch_context_gate_testbench temporal_dispatch_context_gate_module.sv temporal_dispatch_context_gate_testbench.sv --Mdir obj_gate
# RUN: timeout %loom-timeout-xlong %t/obj_gate/Vtemporal_dispatch_context_gate_testbench
# RUN: cd %t && yosys -q -s temporal_dispatch_context_gate.ys
# RUN: cd %t && verilator --binary --timing --Wall --Wno-fatal --Wno-DECLFILENAME --Wno-UNUSEDSIGNAL -CFLAGS '-std=c++20' --top-module temporal_dispatch_context_shared_output_testbench temporal_dispatch_context_shared_output_module.sv temporal_dispatch_context_shared_output_testbench.sv --Mdir obj_shared_output
# RUN: timeout %loom-timeout-xlong %t/obj_shared_output/Vtemporal_dispatch_context_shared_output_testbench
# RUN: cd %t && yosys -q -s temporal_dispatch_context_shared_output.ys
