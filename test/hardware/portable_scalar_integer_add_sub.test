# REQUIRES: circt
# RUN: rm -rf %t && mkdir -p %t
# RUN: %loom-portable-scalar-integer-add-sub-test %t
# RUN: FileCheck %s --check-prefix=RTL < %t/scalar_integer_add_sub.sv
# RUN: FileCheck %s --check-prefix=TB < %t/testbench.sv
# RUN: FileCheck %s --check-prefix=YOSYS < %t/portable_scalar_integer_add_sub.ys

# RTL: module scalar_integer_add_sub
# RTL: input [7:0] data_input_0
# RTL: data_input_1,
# RTL: input [1:0] config_0
# RTL: output [7:0] data_output_0
# RTL: config_0 == 2'h1 ? data_input_0 - data_input_1 : data_input_0 + data_input_1

# TB: module testbench
# TB: config_0 = 2'b10
# TB: config_0 = 2'b01

# YOSYS: hierarchy -check -top scalar_integer_add_sub
# YOSYS: synth -top scalar_integer_add_sub
