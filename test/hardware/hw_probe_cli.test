# REQUIRES: circt
# RUN: %loom-hw-probe --help | FileCheck %s

# CHECK: --loom-local-config=<path>
# CHECK: --probe-dir=<path>

# RUN: rm -rf %t && split-file %s %t
# RUN: chmod +x %t/bin/verilator %t/bin/container
# RUN: mkdir -p %t/home %t/probe
# RUN: env HOME=%t/home PATH=%t/bin:%PATH% %loom-hw-probe --probe-dir=%t/probe | FileCheck %s --check-prefix=PROBE

# PROBE: version: Verilator 5.050 test fixture
# PROBE: runtime: polyarch_container almalinux9
# PROBE: emission: ok

#--- bin/verilator
#!/usr/bin/env bash
set -eu
if [[ "${1-}" == --version ]]; then
  printf '%s\n' 'Verilator 5.050 test fixture'
  exit 0
fi
exit 64

#--- bin/container
#!/usr/bin/env bash
set -eu
if [[ "${1-}" == --version ]]; then
  printf '%s\n' 'PolyArch container v0.1.0 test fixture'
  exit 0
fi
[[ "${1-}" == run ]]
shift
workdir=''
while (( $# )); do
  case "$1" in
    --workdir) workdir=$2; shift 2 ;;
    --os|--env) shift 2 ;;
    --) shift; break ;;
    *) exit 64 ;;
  esac
done
[[ -n "$workdir" ]]
exec "$@"
