# RUN: FileCheck %s --check-prefix=EXP2 < %t/artifacts/scalar_math_exp2.sv
# RUN: FileCheck %s --check-prefix=EXPM1 < %t/artifacts/scalar_math_expm1.sv

# GENERATE: generated 393234 exponential numerical vectors

# EXP: module scalar_math_exp
