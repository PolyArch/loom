# REQUIRES: circt
# RUN: rm -rf %t && mkdir -p %t
# RUN: %loom-amd-xilinx-scalar-integer-multiply-test %t
# RUN: FileCheck %s --check-prefix=WRAPPER < %t/exact/provider_artifacts/amd_xilinx_scalar_integer_multiply.sv
# RUN: FileCheck %s --check-prefix=SYSTEM < %t/exact/provider_artifacts/amd_xilinx_scalar_integer_multiply_system.sv

# WRAPPER-LABEL: module amd_xilinx_multiply_0
# WRAPPER: input [15:0] data_input_0
# WRAPPER: data_input_1,
# WRAPPER: output [15:0] data_output_0
# WRAPPER: DSP58 #(
# WRAPPER: .ACASCREG(0),
# WRAPPER: .AREG(0),
# WRAPPER: .BCASCREG(0),
# WRAPPER: .BREG(0),
# WRAPPER: .DSP_MODE("INT24"),
# WRAPPER: .MREG(0),
# WRAPPER: .OPMODEREG(0),
# WRAPPER: .PREG(0),
# WRAPPER: .USE_MULT("MULTIPLY"),
# WRAPPER: .USE_SIMD("ONE58"),
# WRAPPER: .P{{ *}}({{.*}})
# WRAPPER: .A{{ *}}({{.*}}data_input_0
# WRAPPER: .B{{ *}}({{.*}}data_input_1
# WRAPPER: .OPMODE{{ *}}(9'h5)
# WRAPPER-NOT: always

# SYSTEM-LABEL: module loom_module
# SYSTEM: input {{ *}}clock
# SYSTEM-NEXT: {{ *}}reset
# SYSTEM: input [15:0] input_0_data
# SYSTEM: input input_0_valid
# SYSTEM: input [15:0] input_1_data
# SYSTEM: input input_1_valid
# SYSTEM: {{ *}}output_0_ready
# SYSTEM: output {{ *}}input_0_ready
# SYSTEM-NEXT: {{ *}}input_1_ready
# SYSTEM: output [15:0] output_0_data
# SYSTEM: output output_0_valid
# SYSTEM: reg {{ *}}[15:0] result_data_reg
# SYSTEM: reg {{ *}}result_valid_reg
# SYSTEM: loom_fabric_operation_0 operation (
# SYSTEM: .data_input_0
# SYSTEM: .data_input_1
# SYSTEM: .data_output_0
# SYSTEM: always @(posedge clock or posedge reset)
# SYSTEM: result_data_reg <= _operation_data_output_0
# SYSTEM: result_valid_reg <=
