# REQUIRES: circt
# RUN: rm -rf %t && mkdir -p %t
# RUN: %loom-portable-math-power-test %t
# RUN: FileCheck %s < %t/generated/scalar_math_pow.sv

# CHECK: module scalar_math_pow
# CHECK: input [31:0] data_input_0
# CHECK: data_input_1
# CHECK: input [2:0] config_0
# CHECK: output [31:0] data_output_0
# CHECK: function automatic
# CHECK: loom_math_pow_e5_f10_max4
# CHECK: loom_math_pow_e8_f7_max4
# CHECK-NOT: $pow
# CHECK-NOT: $ln
# CHECK-NOT: $exp
# CHECK-NOT: shortreal
# CHECK-NOT: DPI
