// LLVM: define {{.*}} @hinted({{.*}}) {{.*}} !loom.candidate.function ![[FUNCTION:[0-9]+]]
// LLVM: define {{.*}} @plain(
// LLVM: ![[FUNCTION]] = !{!"loom.candidate.function.2.0|{{[0-9]+}}|{{.*}}candidate_hint_valid.c|2|11|1|1|2|1|2|59"

// RAISED: llvm.func @hinted
// RAISED: llvm.func @plain
// RAISED-NOT: llvm.global.annotations
// RAISED-NOT: loom.candidate

// MULTILINE: llvm.func @hinted_multiline
// MULTILINE-NOT: loom.candidate
// MULTILINE-LLVM: !{!"loom.candidate.function.2.0|{{[0-9]+}}|{{.*}}candidate_hint_multiline.c|3|1|1|1|2|1|3|50"}

// REMAPPED-DAG: llvm.func @hinted_remapped
// REMAPPED-DAG: llvm.func @hinted_nonmonotonic
// REMAPPED-NOT: loom.candidate

// UNRELATED: c"keep.annotation\00"
// UNRELATED: @llvm.global.annotations = appending global [1 x
// UNRELATED-SAME: ptr @preserved_annotation
// UNRELATED: define {{.*}} @projected_candidate({{.*}}) {{.*}} !loom.candidate.function ![[UNRELATED_FUNCTION:[0-9]+]]
// UNRELATED: ![[UNRELATED_FUNCTION]] = !{!"loom.candidate.function.2.0|

// MISPLACED: error: candidate_hint_invalid_placement: '#pragma loom candidate' must immediately precede a function definition
// NESTED: error: candidate_hint_invalid_placement: '#pragma loom candidate' must immediately precede a function definition or loop
// DANGLING: error: candidate_hint_invalid_placement: dangling '#pragma loom candidate' has no function or loop
// TEMPLATE: error: candidate_hint_unsupported_construct: '#pragma loom candidate' does not support function templates
// TEMPLATE: error: candidate_hint_unsupported_construct: '#pragma loom candidate' does not support member functions
// MACRO: error: candidate_hint_unsupported_construct: '#pragma loom candidate' does not support a macro-expanded target boundary
// SWITCH-LABEL: error: candidate_hint_unsupported_construct: '#pragma loom candidate' does not support a loop body with a switch label owned outside the loop
// LAMBDA: error: candidate_hint_unsupported_construct: '#pragma loom candidate' does not support lambda-local loops
// SYNTAX-GUARD: error: 'case' statement not in switch statement
// INTERNAL-REPLAY: loom_internal_invocation_invalid: candidate replay argument is unsupported
// RESERVED-REPLAY: loom_internal_invocation_invalid: candidate replay argument is unsupported
// DISABLED-PIPELINE: candidate_hint_unsupported_construct: candidate projection requires the LLVM pass pipeline
// DISABLED-PLAIN: target triple =
// PRAGMA-OPERATOR: candidate_hint_unsupported_construct: '#pragma loom candidate' cannot use a macro pragma introducer
// DRYCMD: "-cc1"
// PREPROCESSING: candidate_hint_unsupported_construct: preprocessing-only actions cannot preserve exact candidate source ranges
// STDIN-LLVM: !{!"loom.candidate.function.2.0|{{[0-9]+}}|{{.*}}|2|11|1|1|2|1|2|59"
// STDIN-NO-CANDIDATE: .file "<stdin>"
// FORGED: candidate_hint_projection_proof_not_established: candidate function carrier disagrees with its payload
// LOOP-LLVM: define {{.*}} @loop_candidate({{.*}}) {{.*}} !loom.candidate.loops ![[LOOPS:[0-9]+]]
// LOOP-LLVM: define {{.*}} @controlled_loop_candidate({{.*}}) {{.*}} !loom.candidate.function ![[FUNCTION:[0-9]+]] !loom.candidate.loops ![[CONTROLLED_LOOPS:[0-9]+]]
// LOOP-LLVM-DAG: ![[LOOPS]] = !{!"loom.candidate.loop.1.0|1|{{[0-9]+}}|{{.*}}candidate_hint_loop.c|1|5|3|1|5|3|6|27", !"loom.candidate.loop.1.0|2|{{[0-9]+}}|{{.*}}candidate_hint_loop.c|1|5|10|1|12|3|15|4", !"loom.candidate.loop.1.0|3|{{[0-9]+}}|{{.*}}candidate_hint_loop.c|1|5|18|1|20|3|23|24"
// LOOP-LLVM-DAG: ![[CONTROLLED_LOOPS]] = !{!"loom.candidate.loop.1.0|4|{{[0-9]+}}|{{.*}}candidate_hint_loop.c|30|5|33|1|35|5|36|29"
// LOOP-LLVM-DAG: !{!"llvm.loop.loom.candidate", !"loom.candidate.loop.1.0|1|
// LOOP-LLVM-DAG: !{!"llvm.loop.loom.candidate", !"loom.candidate.loop.1.0|2|
// LOOP-LLVM-DAG: !{!"llvm.loop.loom.candidate", !"loom.candidate.loop.1.0|3|
// LOOP-LLVM-DAG: ![[FUNCTION]] = !{!"loom.candidate.function.2.0|
// LOOP-LLVM-DAG: !{!"llvm.loop.loom.candidate", !"loom.candidate.loop.1.0|4|
// LOOP-RAISED: llvm.func {{.*}}@loop_candidate
// LOOP-RAISED-COUNT-4: scf.{{for|while}}
// LOOP-RAISED-NOT: llvm.annotation
// LOOP-RAISED-NOT: llvm.global.annotations
// LOOP-RAISED-NOT: loom.candidate
// LOOP-ERASED: candidate_hint_projection_proof_not_established: optimization erased or rewrote a candidate loop target
// INTERNAL: llvm.func internal @hinted_internal
// INTERNAL-NOT: loom.candidate
// LLVM-LTO: define internal i32 @hinted_internal
// LLVM-LTO-SAME: !loom.candidate.function
