# RUN: env LOOM_CC=%loom-cc LOOM_RAISE=%loom-raise LOOM_LOWER=%loom-lower LOOM_RAISE_OPT=%loom-raise-opt bash %S/../cmsis-dsp/run_cmsis_dsp_dfg.sh | FileCheck %s
