# Drives the cmsis-dsp LLVM IR drop-in pipeline from lit. The pipeline
# script lives in test/cmsis-dsp/; this lit case is the single
# integration point so the pipeline runs alongside the rest of the
# regression suite. We pin LOOM_CC explicitly because lit may run with
# a clean PATH. The bash -c wrapper turns on pipefail so a runner
# exit-nonzero before the summary line still propagates failure
# through the FileCheck pipe.
#
# RUN: bash -c 'set -o pipefail; env LOOM_CC=%loom-cc bash %S/../cmsis-dsp/run_cmsis_dsp_ir.sh' | FileCheck %s
#
# CHECK: ==== cmsis-dsp LLVM IR smoke summary ====
# CHECK: all 16 cmsis-dsp source(s) passed
