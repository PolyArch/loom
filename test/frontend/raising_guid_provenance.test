# RUN: %loom-raise %S/Inputs/guid_provenance.ll -o %t.first.mlir
# RUN: %loom-raise %t.relocated.ll -o %t.second.mlir
# RUN: diff %t.first.mlir %t.second.mlir
# RUN: FileCheck %s --input-file=%t.first.mlir

