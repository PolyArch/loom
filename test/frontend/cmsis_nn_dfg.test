# Runs the representative CMSIS-NN source-to-DFG integration path.
# Tool paths are explicit because lit may run with a clean PATH.
#
# RUN: env LOOM_CC=%loom-cc LOOM_RAISE=%loom-raise LOOM_LOWER=%loom-lower LOOM_RAISE_OPT=%loom-raise-opt bash %S/../cmsis-nn/run_cmsis_nn_dfg.sh | FileCheck %s
#
# CHECK: PASS  {{.+}}
# CHECK: PASS  {{.+}}
# CHECK: PASS  {{.+}}
# CHECK: [cmsis-nn-dfg] PASS
