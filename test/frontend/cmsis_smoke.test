# Drives the cmsis-core LLVM IR drop-in pipeline from lit. The pipeline
# script lives in test/cmsis/; this lit case is the single integration
# point so the pipeline runs alongside the rest of the regression suite.
# We pin LOOM_CC explicitly because lit may run with a clean PATH.
#
# RUN: env LOOM_CC=%loom-cc bash %S/../cmsis/run_cmsis_ir.sh | FileCheck %s
#
# CHECK: ==== cmsis-core LLVM IR smoke summary ====
# CHECK: all {{[0-9]+}} cmsis-core source(s) passed
