# Drives the LLVM IR -> SCF MLIR raise-pipeline smoke tests for every
# kernel under test/app via run_raise_all.sh. We pin LOOM_CC and
# LOOM_RAISE explicitly because lit may run with a clean PATH.
# The bash -c wrapper turns on pipefail so a runner exit-nonzero before
# the summary line still propagates failure through the FileCheck pipe.
#
# RUN: bash -c 'set -o pipefail; env LOOM_CC=%loom-cc LOOM_CXX=%loom-c++ LOOM_RAISE=%loom-raise bash %S/../app/run_raise_all.sh' | FileCheck %s
#
# CHECK: ==== raise summary ====
# CHECK: all 7 kernel(s) passed
