//===- MappingObjectiveKinds.def - Mapping objective catalog -*- C++ -*-===//
//
// Single declaration source for the closed Mapping-owned PnR objective
// registry. Ordinals are stable schema values. DisplayName is diagnostic-only;
// ConfigSpelling is the canonical ResolvedConfig spelling.
//
//===----------------------------------------------------------------------===//

#ifndef LOOM_MAPPING_VIOLATION
#define LOOM_MAPPING_VIOLATION(Name, Ordinal, DisplayName, ConfigSpelling)
#endif

#ifndef LOOM_MAPPING_MEASURE
#define LOOM_MAPPING_MEASURE(Name, Ordinal, DisplayName)
#endif

LOOM_MAPPING_VIOLATION(UnroutedObligation, 0, "UnroutedObligation",
                       "unrouted_obligation")
LOOM_MAPPING_VIOLATION(CapacityOveruse, 1, "CapacityOveruse",
                       "capacity_overuse")
LOOM_MAPPING_VIOLATION(TagUnassigned, 2, "TagUnassigned", "tag_unassigned")
LOOM_MAPPING_VIOLATION(TagConflict, 3, "TagConflict", "tag_conflict")
LOOM_MAPPING_VIOLATION(HardProgressViolation, 4, "HardProgressViolation",
                       "hard_progress_violation")
LOOM_MAPPING_VIOLATION(ProgressProofDebt, 5, "ProgressProofDebt",
                       "progress_proof_debt")
LOOM_MAPPING_VIOLATION(RuntimeCounterexampleViolation, 6,
                       "RuntimeCounterexampleViolation",
                       "runtime_counterexample_violation")
LOOM_MAPPING_VIOLATION(SelectedHandshakeViolation, 7,
                       "SelectedHandshakeViolation",
                       "selected_handshake_violation")

LOOM_MAPPING_MEASURE(TotalSelectedTraversalClaim, 0,
                     "TotalSelectedTraversalClaim")
LOOM_MAPPING_MEASURE(StaticSchedulePressure, 1, "StaticSchedulePressure")
LOOM_MAPPING_MEASURE(RecurrenceMinimumInitiationIntervalCycles, 2,
                     "RecurrenceMinimumInitiationIntervalCycles")
LOOM_MAPPING_MEASURE(ResourceMinimumInitiationIntervalCycles, 3,
                     "ResourceMinimumInitiationIntervalCycles")
LOOM_MAPPING_MEASURE(TransportBitCycleDemand, 4, "TransportBitCycleDemand")
LOOM_MAPPING_MEASURE(WorstRouteArrivalDelayQuanta, 5,
                     "WorstRouteArrivalDelayQuanta")
LOOM_MAPPING_MEASURE(TotalRouteNegativeSlackQuanta, 6,
                     "TotalRouteNegativeSlackQuanta")
LOOM_MAPPING_MEASURE(SharedOperandIngressPressure, 7,
                     "SharedOperandIngressPressure")
LOOM_MAPPING_MEASURE(ProgressCapacityShortfall, 8,
                     "ProgressCapacityShortfall")
LOOM_MAPPING_MEASURE(ProgressRouteAnchorCount, 9,
                     "ProgressRouteAnchorCount")

#undef LOOM_MAPPING_MEASURE
#undef LOOM_MAPPING_VIOLATION
