//===- HwShareGroups.def - Hardware sharing registry -----------*- C++ -*-===//
//
// This file is the single source of truth for multi-member hardware sharing
// families. Define LOOM_HW_SHARE_GROUP, LOOM_HW_SHARE_MEMBER, and
// LOOM_HW_SHARE_GROUP_END before including it.
//
// Most members are registered MLIR operation names. An intrinsic semantic key
// such as llvm.arm.sadd16 may name a real implementation family used by legacy
// hardware descriptions, but it is not by itself a materializable normalized
// mode. Canonical modes still require a registered operation representation.
//
//===----------------------------------------------------------------------===//

LOOM_HW_SHARE_GROUP(integer_add_sub)
LOOM_HW_SHARE_MEMBER("arith.addi")
LOOM_HW_SHARE_MEMBER("arith.subi")
LOOM_HW_SHARE_GROUP_END()

LOOM_HW_SHARE_GROUP(signed_div_rem)
LOOM_HW_SHARE_MEMBER("arith.divsi")
LOOM_HW_SHARE_MEMBER("arith.remsi")
LOOM_HW_SHARE_GROUP_END()

LOOM_HW_SHARE_GROUP(unsigned_div_rem)
LOOM_HW_SHARE_MEMBER("arith.divui")
LOOM_HW_SHARE_MEMBER("arith.remui")
LOOM_HW_SHARE_GROUP_END()

LOOM_HW_SHARE_GROUP(integer_shift)
LOOM_HW_SHARE_MEMBER("arith.shli")
LOOM_HW_SHARE_MEMBER("arith.shrsi")
LOOM_HW_SHARE_MEMBER("arith.shrui")
LOOM_HW_SHARE_GROUP_END()

LOOM_HW_SHARE_GROUP(bitwise_logic)
LOOM_HW_SHARE_MEMBER("arith.andi")
LOOM_HW_SHARE_MEMBER("arith.ori")
LOOM_HW_SHARE_MEMBER("arith.xori")
LOOM_HW_SHARE_GROUP_END()

LOOM_HW_SHARE_GROUP(signed_min_max)
LOOM_HW_SHARE_MEMBER("arith.minsi")
LOOM_HW_SHARE_MEMBER("arith.maxsi")
LOOM_HW_SHARE_GROUP_END()

LOOM_HW_SHARE_GROUP(unsigned_min_max)
LOOM_HW_SHARE_MEMBER("arith.minui")
LOOM_HW_SHARE_MEMBER("arith.maxui")
LOOM_HW_SHARE_GROUP_END()

LOOM_HW_SHARE_GROUP(integer_compare)
LOOM_HW_SHARE_MEMBER("arith.cmpi")
LOOM_HW_SHARE_MEMBER("llvm.icmp")
LOOM_HW_SHARE_GROUP_END()

LOOM_HW_SHARE_GROUP(integer_to_float)
LOOM_HW_SHARE_MEMBER("arith.sitofp")
LOOM_HW_SHARE_MEMBER("arith.uitofp")
LOOM_HW_SHARE_GROUP_END()

LOOM_HW_SHARE_GROUP(float_to_integer)
LOOM_HW_SHARE_MEMBER("arith.fptosi")
LOOM_HW_SHARE_MEMBER("arith.fptoui")
LOOM_HW_SHARE_GROUP_END()

LOOM_HW_SHARE_GROUP(float_add_sub)
LOOM_HW_SHARE_MEMBER("arith.addf")
LOOM_HW_SHARE_MEMBER("arith.subf")
LOOM_HW_SHARE_GROUP_END()

LOOM_HW_SHARE_GROUP(float_div_rem)
LOOM_HW_SHARE_MEMBER("arith.divf")
LOOM_HW_SHARE_MEMBER("arith.remf")
LOOM_HW_SHARE_GROUP_END()

LOOM_HW_SHARE_GROUP(float_min_max)
LOOM_HW_SHARE_MEMBER("arith.minimumf")
LOOM_HW_SHARE_MEMBER("arith.maximumf")
LOOM_HW_SHARE_GROUP_END()

LOOM_HW_SHARE_GROUP(trigonometric_pair)
LOOM_HW_SHARE_MEMBER("math.sin")
LOOM_HW_SHARE_MEMBER("math.cos")
LOOM_HW_SHARE_GROUP_END()

LOOM_HW_SHARE_GROUP(hyperbolic_pair)
