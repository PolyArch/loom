//===- FabricRefs.def - Fabric persistent reference catalog ----*- C++ -*-===//
//
// Single source of truth for every closed sum of the Mapping-visible Fabric
// persistent reference catalog owned by docs/spec-fabric-identity.md.
//
// Lists without an explicit Ordinal assign zero-based unsigned 32-bit
// discriminants in declaration order. Lists with an Ordinal preserve stable
// wire values and may contain retired holes. Those values are immutable for
// every Fabric root schema version that imports this catalog: entries are
// appended, never reordered or reinterpreted. The schema records, the strict
// text codec, the canonical byte codec, and the importer all read this file,
// so no tag number or canonical keyword is written down a second time.
//
//===---------------------------------------------------------------------===//

// Entity kinds of the one artifact-global unsigned 64-bit EntityId namespace.
// Name is the enumerator; the typed reference is Name + "Ref".
#ifndef LOOM_FABRIC_ENTITY
#define LOOM_FABRIC_ENTITY(Name, Keyword)
#endif

// Root variants of the loom.fabric artifact family. Semantics are owned by
// docs/spec-fabric-artifact.md.
#ifndef LOOM_FABRIC_ROOT_KIND
#define LOOM_FABRIC_ROOT_KIND(Name, Keyword)
#endif

// Placeable-graph node domains inside one FU.
#ifndef LOOM_FABRIC_FU_NODE_KIND
#define LOOM_FABRIC_FU_NODE_KIND(Name, Keyword)
#endif

// Port directions of every typed FU port family.
#ifndef LOOM_FABRIC_PORT_DIRECTION
#define LOOM_FABRIC_PORT_DIRECTION(Name, Keyword)
#endif

// Memory-service variants. Type is the selected payload reference.
#ifndef LOOM_FABRIC_MEMORY_SERVICE
#define LOOM_FABRIC_MEMORY_SERVICE(Name, Keyword, Type)
#endif

// Closed hardware-domain kinds owned by docs/spec-fabric-system-adg.md.
#ifndef LOOM_FABRIC_HARDWARE_DOMAIN_KIND
#define LOOM_FABRIC_HARDWARE_DOMAIN_KIND(Name, Keyword)
#endif

// Symbolic domain-slot kinds owned by docs/spec-fabric-module.md. This is a
// deliberately narrower domain than the System hardware-domain catalog.
#ifndef LOOM_FABRIC_CLOCK_RESET_KIND
#define LOOM_FABRIC_CLOCK_RESET_KIND(Name, Keyword)
#endif

// Memory-service endpoint roles owned by docs/spec-fabric-mem.md.
#ifndef LOOM_FABRIC_MEMORY_ENDPOINT_ROLE
#define LOOM_FABRIC_MEMORY_ENDPOINT_ROLE(Name, Keyword)
#endif

// FIFO occurrence traversal modes owned by docs/spec-fabric-fifo.md.
#ifndef LOOM_FABRIC_FIFO_MODE
#define LOOM_FABRIC_FIFO_MODE(Name, Keyword)
#endif

// Temporal-PE register-FIFO path roles owned by
// docs/spec-fabric-pe-temporal.md.
#ifndef LOOM_FABRIC_REGISTER_FIFO_PATH_ROLE
#define LOOM_FABRIC_REGISTER_FIFO_PATH_ROLE(Name, Keyword)
#endif

// Directed physical traversal variants. Type is the payload record.
#ifndef LOOM_FABRIC_TRAVERSAL
#define LOOM_FABRIC_TRAVERSAL(Name, Keyword, Type)
#endif

// Owner-declared canonical inventories an owner-relative ordinal indexes.
// This is an import-time selector, not persistent identity.
#ifndef LOOM_FABRIC_INVENTORY
#define LOOM_FABRIC_INVENTORY(Name, Keyword)
#endif

// Closed union of owners exposing a token transport endpoint inventory.
#ifndef LOOM_FABRIC_TRANSPORT_OWNER
#define LOOM_FABRIC_TRANSPORT_OWNER(Ordinal, Name, Type)
#endif

// Closed union of owners exposing a memory-service endpoint inventory.
#ifndef LOOM_FABRIC_MEMORY_OWNER
#define LOOM_FABRIC_MEMORY_OWNER(Ordinal, Name, Type)
#endif

// Closed constructor catalog shared by every owner projection below.
#ifndef LOOM_FABRIC_INVENTORY_OWNER
#define LOOM_FABRIC_INVENTORY_OWNER(Name, Type)
#endif

// Closed union of physical owners declared inside one reusable Module.
// Validator is the single structural role admission policy used by factories
// and both persistent codecs.
#ifndef LOOM_FABRIC_MODULE_PHYSICAL_OWNER
#define LOOM_FABRIC_MODULE_PHYSICAL_OWNER(Ordinal, Name, Type, Validator)
#endif

// Closed Module domain-member relation.
#ifndef LOOM_FABRIC_MODULE_DOMAIN_MEMBER
#define LOOM_FABRIC_MODULE_DOMAIN_MEMBER(Ordinal, Name, Type)
#endif

// Closed Module-local physical target relation. Validator rejects nested
// System and SpatialCore roles before a target can become persistent state.
#ifndef LOOM_FABRIC_MODULE_PHYSICAL_TARGET
#define LOOM_FABRIC_MODULE_PHYSICAL_TARGET(Ordinal, Name, Type, Validator)
#endif

// System-root owners and their Clock/Reset role admission share one catalog.
// DirectValidator admits the general System role. ClockResetValidator selects
// its exact Clock/Reset subset without a second owner-kind table.
#ifndef LOOM_FABRIC_DIRECT_SYSTEM_OWNER
#define LOOM_FABRIC_DIRECT_SYSTEM_OWNER(                                      \
    Name, Type, DirectValidator, ClockResetValidator)
#endif

#ifndef LOOM_FABRIC_SPATIAL_CORE_DOMAIN_TARGET
#define LOOM_FABRIC_SPATIAL_CORE_DOMAIN_TARGET(Ordinal, Name, Type, Validator)
#endif

#ifndef LOOM_FABRIC_PHYSICAL_OCCURRENCE_OWNER
#define LOOM_FABRIC_PHYSICAL_OCCURRENCE_OWNER(Ordinal, Name, Type, Validator)
#endif

#ifndef LOOM_FABRIC_PHYSICAL_CONFIGURATION_FIELD
#define LOOM_FABRIC_PHYSICAL_CONFIGURATION_FIELD(Ordinal, Name, Type,          \
                                                 Validator)
#endif

#ifndef LOOM_FABRIC_HARDWARE_DOMAIN_MEMBER
#define LOOM_FABRIC_HARDWARE_DOMAIN_MEMBER(Ordinal, Name, Type, Validator)
#endif

// The role-specific owner projections. Each is a distinct static type over
// the one constructor catalog above and selects the canonical inventory its
// consuming family indexes.
#ifndef LOOM_FABRIC_OWNER_ROLE
#define LOOM_FABRIC_OWNER_ROLE(Alias, Inventory, Family, Keyword)
#endif

// Typed refinements: a name selected by the consuming field's static type
// whose canonical form remains exactly that of Underlying.
#ifndef LOOM_FABRIC_REFINEMENT
#define LOOM_FABRIC_REFINEMENT(Name, Alias, Underlying)
#endif

// Complete loom.fabric 6.x owner-local ArtifactLocalReference kind catalog.
// Ordinal is the stable Common owner_local_kind and Type is its exact typed
// target. Nested unions and endpoint components are intentionally absent
// unless they are listed here.
#ifndef LOOM_FABRIC_LOCAL_REFERENCE_KIND
#define LOOM_FABRIC_LOCAL_REFERENCE_KIND(Ordinal, Type)
#endif

// Typed classification of every identity failure. Mapping feasibility
// failures are deliberately absent.
#ifndef LOOM_FABRIC_REF_ERROR
#define LOOM_FABRIC_REF_ERROR(Name, Keyword)
#endif

// Retired and generic spellings that must be reported as such instead of as
// ordinary syntax noise.
#ifndef LOOM_FABRIC_DEPRECATED_REF
#define LOOM_FABRIC_DEPRECATED_REF(Keyword)
#endif

