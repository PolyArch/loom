                <mxCell id="df-legend" value="legend&lt;div style=&quot;font-size:9px&quot;&gt;outer rounded boxes = ops with regions (thread, graph)&lt;/div&gt;&lt;div style=&quot;font-size:9px&quot;&gt;light-grey boxes = explicit none / token control ports&lt;/div&gt;&lt;div style=&quot;font-size:9px&quot;&gt;yellow box = ScalarCore-side bridge (thread.fence)&lt;/div&gt;&lt;div style=&quot;font-size:9px&quot;&gt;dashed arrows = none / thread_token control flow&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="890" width="770" height="100" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>
